{
  "title": "aimon-memory",
  "uid": "aimon-memory-overview",
  "tags": [
    "aimon.memory"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue depth",
      "description": "The first number to look at. Rising while throughput is flat means work units are not being claimed \u2014 a stalled worker, an exhausted provider quota, or a leaked claim.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(aimon_memory_queue_pending) or vector(0)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest unprocessed work unit",
      "description": "The one alert worth having from day one: older than batch.max_age plus a margin catches a stalled worker, a provider outage and a claim leak, all of which are otherwise silent.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(aimon_memory_queue_oldest_seconds) or vector(0)",
          "legendFormat": "age",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Work unit duration",
      "description": "Dominated by the provider call. A p99 that climbs while the database is idle is the model being slow, not the store.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(aimon_memory_worker_unit_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aimon_memory_worker_unit_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aimon_memory_worker_unit_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Items processed by task",
      "description": "Flat while queue depth grows is the signature of stuck claims.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(aimon_memory_worker_items_total[5m])) by (task)",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Quarantined items",
      "description": "Any increase is a batch that failed max-attempts times and was given up on. Because the queue serialises on the work unit key, not giving up would block every later batch for that pair \u2014 so this is a deliberate loss, and each one is worth reading.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(aimon_memory_worker_quarantined_total[1h]))",
          "legendFormat": "last hour",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP request duration",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri!~\".*actuator.*\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\".*actuator.*\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri!~\".*actuator.*\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recall latency by outcome",
      "description": "Tier 1 is supposed to be cheap and deterministic. A p95 drifting upward usually means one pair has grown large enough that the planner switched from scanning it to walking the HNSW graph, at which point ef_search starts to matter.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\".*recall.*\"}[5m])) by (le, status))",
          "legendFormat": "{{status}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Connection pool",
      "description": "Sustained non-zero pending means the pool is undersized. On the worker that is unusual by design: a work unit holds a connection only around its queries, never across the model call, so pool pressure there points at a query that got slow rather than at concurrency.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active) by (pool)",
          "legendFormat": "active {{pool}}",
          "refId": "A"
        },
        {
          "expr": "sum(hikaricp_connections_pending) by (pool)",
          "legendFormat": "pending {{pool}}",
          "refId": "B"
        },
        {
          "expr": "sum(hikaricp_connections_max) by (pool)",
          "legendFormat": "max {{pool}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "title": "Client vs server errors",
      "description": "Kept apart on purpose. Malformed requests used to surface as 500s, which buried real faults in noise; separating them is what makes the 5xx line mean something.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "JVM heap and GC",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (job)",
          "legendFormat": "heap {{job}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m])) by (job)",
          "legendFormat": "gc {{job}}",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus"
        },
        "query": "label_values(up, job)",
        "multi": true,
        "includeAll": true
      }
    ]
  }
}
