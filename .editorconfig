root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
# 120, because two things enforce that number and this file enforces nothing: `LineLength` in
# config/checkstyle/checkstyle.xml and `lineSplit` in config/eclipse/eclipse-formatter.xml. This line is
# the editor's copy of their answer, and it read 110 for long enough to be documented as the limit. Move
# all three together or not at all.
max_line_length = 120

[*.{kts,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4
